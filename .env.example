# Resend API key — vraag aan op https://resend.com (gratis tier is voldoende voor de meeste klanten)
RESEND_API_KEY=re_placeholder_replace_me

# Het FROM-adres moet een geverifieerd domein in Resend zijn.
# Tip: laat klant een MX/DKIM-record zetten op no-reply@hundomein.nl, dan komen mails niet in spam.
RESEND_FROM_EMAIL=no-reply@example.nl

# Optioneel: stuur kopie naar dit adres (bijv. eigen monitoring-inbox)
RESEND_BCC_EMAIL=

# Productie-URL (gebruikt in sitemap.xml en canonical tags). Geen trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.nl
